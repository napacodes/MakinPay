{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-zip": "*",
        "bacon/bacon-qr-code": "^3.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "cryptomus/api-php-sdk": "^1.0",
        "intervention/image": "^3.11",
        "jenssegers/agent": "^2.6",
        "joedixon/laravel-translation": "^1.1",
        "laravel-notification-channels/twilio": "^4.1",
        "laravel-notification-channels/webpush": "^10.5",
        "laravel/framework": "^11.44",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.34",
        "mews/purifier": "^3.4",
        "mollie/mollie-api-php": "^3.0",
        "pragmarx/google2fa": "^8.0",
        "spatie/laravel-permission": "^6.9",
        "stripe/stripe-php": "^17.2"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.2",
        "fakerphp/faker": "^1.23",
        "laradumps/laradumps": "^4.5",
        "laradumps/laradumps-core": "^3.2",
        "laramint/laravel-brain": "^2.1",
        "laravel/boost": "^2.1",
        "laravel/pint": "^1.21",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "classmap": [
            "app/Services/Payment"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": [
            "@test:parallel",
            "@test:serial"
        ],
        "test:parallel": "@php vendor/bin/pest --parallel --exclude-group=serial,mysql",
        "test:serial": "@php vendor/bin/pest --group=serial",
        "test:installation": "@php vendor/bin/pest tests/Feature/Installation",
        "test:updater": "@php vendor/bin/pest tests/Feature/Updater",
        "test:payments": "@php vendor/bin/pest tests/Feature/Payments",
        "test:addons": "@php vendor/bin/pest tests/Feature/Addons",
        "test:mysql": "@php vendor/bin/pest --group=mysql",
        "test:coverage": "@php vendor/bin/pest --coverage --exclude-group=serial,mysql"
    },
    "scripts-descriptions": {
        "test": "Run the whole suite: everything in parallel, then the serial group on its own.",
        "test:parallel": "Everything that is safe to run in four processes at once.",
        "test:serial": "The suites that own a path outside their own database - the maintenance down file, the release zip, public/custom-landings, the updater's archives, and the baseline seeders.",
        "test:installation": "Installation preflight, administrator provisioning and the makinpay:install command.",
        "test:updater": "Updater package signature verification and protected-path enforcement.",
        "test:payments": "Payment gateway registration regression (no external requests).",
        "test:addons": "Add-on licensing enforcement after the core licensing removal.",
        "test:mysql": "Opt-in MySQL integration tests; requires MAKINPAY_ALLOW_MYSQL_TESTS.",
        "test:coverage": "Run the parallel suite with a coverage report (needs Xdebug or PCOV)."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
