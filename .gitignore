.phpunit.cache/
.phpunit.result.cache

# IDE and editor
.idea/
.vscode/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Build and generated files
/public/build/
/public/hot

# Database dumps and backups
/DB/*.sql
/DB/*.sql.gz
/DB/*.zip