
# ==========================================================
# MAKINPAY - ENVIRONMENT CONFIGURATION
# ==========================================================

APP_NAME="MakinPay"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Wallet configuration
WALLET_ID_PREFIX=MP

# Demo mode
APP_DEMO=false
APP_DEMO_VENDOR_NAME="MakinPay"
APP_DEMO_VENDOR_URL=
APP_DEMO_PRODUCT_NAME="MakinPay"
APP_DEMO_SALES_URL=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

DUPLICATE_SUBMISSION_TIMEOUT=5

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================================
# DATABASE
# ==========================================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=makinpay
DB_USERNAME=root
DB_PASSWORD=

# ==========================================================
# SESSION / CACHE / QUEUE
# ==========================================================

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

# ==========================================================
# REDIS
# ==========================================================

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# ==========================================================
# REMITTANCE / COMPLIANCE
# ==========================================================

REMITTANCE_COMPLIANCE_DRIVER=local
REMITTANCE_COMPLIANCE_ENDPOINT=
REMITTANCE_COMPLIANCE_HEALTH_ENDPOINT=
REMITTANCE_COMPLIANCE_TOKEN=
REMITTANCE_RECONCILE_AFTER_MINUTES=5
REMITTANCE_STUCK_AFTER_MINUTES=30
REMITTANCE_ALERT_REPEAT_MINUTES=360

# ==========================================================
# MAIL
# ==========================================================

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================
# TWILIO
# ==========================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_DEBUG_TO=

# ==========================================================
# AWS / S3
# ==========================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================================
# VITE
# ==========================================================

VITE_APP_NAME="${APP_NAME}"

# ==========================================================
# LARAVEL REVERB
# ==========================================================

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ==========================================================
# GOOGLE RECAPTCHA
# ==========================================================

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_STATUS=false

# ==========================================================
# PROJECT UPDATER
# Configure only after implementing a MakinPay updater.
# ==========================================================

PROJECT_UPDATER_SERVER_URL=
PROJECT_UPDATER_ENVATO_ITEM_ID=
PROJECT_UPDATER_PRODUCT_SLUG=makinpay
PROJECT_UPDATER_CHANNEL=stable
PROJECT_UPDATER_INSTALL_ENABLED=false
PROJECT_UPDATER_PUBLIC_KEY=

# ==========================================================
# WEB PUSH / VAPID
# ==========================================================

VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ==========================================================
# FIREBASE CLOUD MESSAGING
# ==========================================================

FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
FCM_CREDENTIALS_JSON=
